# Placeholder values only -- NEVER put real credentials in this file.
#
# The nginx envsubst step needs every API key variable to be *defined* before it
# can render nginx-prices.conf.template; an undefined one is left as literal
# `${...}` text and nginx then refuses to start ("unknown variable").
#
# Listed FIRST in the compose `env_file:` list on purpose: the platform-managed
# /run/base44/app.env comes after it and always overrides these values.
#
# Fiat rates are served by the provider's keyless open endpoint, so there is no
# EXCHANGE_API_KEY any more -- only the crypto proxy injects a credential.

CRYPTOCOMPARE_API_KEY=placeholder
